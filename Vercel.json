{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "openjarvis-server": {
      "root": ".",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "src-tauri": {
      "root": "frontend/src-tauri",
      "runtime": "rust"
    },
    "openjarvis-python": {
      "root": "rust/crates/openjarvis-python",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "openjarvis-server"
      }
    }
  ]
}


   ```json
   "bindings": [
     { "type": "service", "service": "inventory", "format": "url", "env": "INVENTORY_URL" }
   ]
   ```
